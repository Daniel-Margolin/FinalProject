<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalProject.Views.RegisterPage"
             Title="RegisterPage"
             BackgroundColor="#111111"
             Shell.NavBarIsVisible="False">
    <ScrollView BackgroundColor="#111111">
        <VerticalStackLayout Padding="24,30,24,30"
                             Spacing="12"
                             BackgroundColor="#111111">

            <Label Text="Final Step!&#10;Create an account"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,25" />

            <Label Text="Enter your new username:"
                   TextColor="#EEEEEE"
                   FontSize="16" />

            <Entry x:Name="UserName"
                   Placeholder="Username"
                   PlaceholderColor="#999999"
                   TextColor="White"
                   BackgroundColor="#242424"
                   HeightRequest="55" />

            <Label x:Name="errUserName"
                   TextColor="#FF6B6B"
                   FontSize="13" />

            <Label Text="Enter your email:"
                   TextColor="#EEEEEE"
                   FontSize="16" />

            <Entry x:Name="EmailAdress"
                   Placeholder="Email"
                   Keyboard="Email"
                   PlaceholderColor="#999999"
                   TextColor="White"
                   BackgroundColor="#242424"
                   HeightRequest="55" />

            <Label x:Name="errEmail"
                   TextColor="#FF6B6B"
                   FontSize="13" />

            <Label Text="Enter your new password:"
                   TextColor="#EEEEEE"
                   FontSize="16" />

            <Entry x:Name="PassWord"
                   Placeholder="Password"
                   IsPassword="True"
                   PlaceholderColor="#999999"
                   TextColor="White"
                   BackgroundColor="#242424"
                   HeightRequest="55" />

            <Label x:Name="errPassword"
                   TextColor="#FF6B6B"
                   FontSize="13" />

            <Label Text="Confirm password:"
                   TextColor="#EEEEEE"
                   FontSize="16" />

            <Entry x:Name="ConfirmPassWord"
                   Placeholder="Confirm Password"
                   IsPassword="True"
                   PlaceholderColor="#999999"
                   TextColor="White"
                   BackgroundColor="#242424"
                   HeightRequest="55" />

            <Label x:Name="errConfirmPassword"
                   TextColor="#FF6B6B"
                   FontSize="13" />


            <Label x:Name="errDateOfBirth"
                   TextColor="#FF6B6B"
                   FontSize="13" />

            <Label Text="Already have an account? Go back"
                   TextColor="#BBBBBB"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,16,0,8">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLoginClicked" />
                </Label.GestureRecognizers>
            </Label>

            <Button Text="Register"
                    Clicked="OnRegisterButtonClicked"
                    BackgroundColor="White"
                    TextColor="#151515"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="40"
                    HeightRequest="60"
                    Margin="0,12,0,10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>