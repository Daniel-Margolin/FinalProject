<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalProject.Views.WelcomePage"
             Title="WelcomePage"
             BackgroundColor="#111111">
    <Grid Padding="24,30,24,30"
          RowDefinitions="*,Auto"
          RowSpacing="24">

        <!-- MuscleUp branding -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="12"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Image
                Source="muscleup.png"
                Aspect="AspectFit"
                WidthRequest="340"
                HorizontalOptions="Center" />

            <Label
                Text="BUILD YOUR STRENGTH."
                FontSize="13"
                CharacterSpacing="4"
                TextColor="#BBBBBB"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center" />

        </VerticalStackLayout>

        <!-- Welcome buttons -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="16">

            <Button
                Text="Get my diet and training plan"
                BackgroundColor="#FFFFFF"
                TextColor="#151515"
                FontSize="18"
                FontAttributes="Bold"
                CornerRadius="50"
                HeightRequest="68"
                Padding="12,0"
                Clicked="OnSignUpClicked" />

            <Button
                Text="I already have an account"
                BackgroundColor="Transparent"
                TextColor="#FFFFFF"
                BorderColor="#505050"
                BorderWidth="1.5"
                FontSize="18"
                FontAttributes="Bold"
                CornerRadius="50"
                HeightRequest="68"
                Padding="12,0"
                Clicked="OnLoginClicked" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>